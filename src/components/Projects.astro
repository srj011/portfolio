---
import GitHubIcon from "./icons/GitHubIcon.astro";
---

<section id="projects" class="py-28 px-6 bg-zinc-900 border-t border-zinc-800">
    <div class="max-w-6xl mx-auto space-y-14">
        <!-- Section heading -->
        <div class="space-y-4 reveal">
            <h2 class="text-4xl font-semibold tracking-tight text-zinc-100">
                Projects
            </h2>
            <div class="h-0.5 w-12 bg-indigo-500 rounded-full"></div>
            <p class="text-zinc-400 max-w-2xl">
                A selection of academic and personal projects focused on game
                logic, GUI development, and systems programming.
            </p>
        </div>

        <!-- Projects grid -->
        <div class="grid md:grid-cols-2 gap-8 auto-rows-fr">
            <!-- ================= Project 1 ================= -->
            <article
                class="project-card card-glow reveal p-7 h-full flex flex-col rounded-xl border border-zinc-700 bg-zinc-800/70 backdrop-blur-sm transition"
            >
                <!-- Header -->
                <div class="flex items-start justify-between">
                    <h3 class="text-base font-semibold text-zinc-100">
                        Battleship Game
                    </h3>
                    <span class="badge badge-ongoing">Ongoing</span>
                </div>

                <!-- Description -->
                <p class="text-zinc-400 mt-3 leading-relaxed">
                    A Battleship project evolving from a Rust game engine toward
                    a planned full-stack system, currently focused on state
                    modeling and strategic AI behavior.
                </p>

                <!-- Footer -->
                <div class="mt-auto pt-6 flex flex-col gap-4">
                    <div class="flex flex-wrap gap-2">
                        <span class="tag">Rust</span>
                        <span class="tag">AI Strategy</span>
                        <span class="tag">Axum (Planned)</span>
                        <span class="tag">React (Planned)</span>
                    </div>

                    <a
                        href="https://github.com/srj011/battleship"
                        target="_blank"
                        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium
                        bg-indigo-500/80 hover:bg-indigo-500
                        text-white rounded-md
                        shadow-sm hover:shadow-md
                        transition-all duration-200"
                    >
                        <GitHubIcon />
                        <span>View Repository</span>
                    </a>
                </div>
            </article>

            <!-- ================= Project 2 ================= -->
            <article
                class="project-card card-glow reveal p-7 h-full flex flex-col rounded-xl border border-zinc-700 bg-zinc-800/70 backdrop-blur-sm transition"
            >
                <div class="flex items-start justify-between">
                    <h3 class="text-base font-semibold text-zinc-100">
                        Minesweeper Game
                    </h3>
                    <span class="badge badge-completed">Completed</span>
                </div>

                <p class="text-zinc-400 mt-3 leading-relaxed">
                    A complete Minesweeper implementation featuring grid-based
                    logic, recursive cell reveals, and interactive GUI elements.
                </p>

                <div class="mt-auto pt-6 flex flex-col gap-4">
                    <div class="flex flex-wrap gap-2">
                        <span class="tag">Python</span>
                        <span class="tag">Tkinter</span>
                    </div>

                    <a
                        href="https://github.com/srj011/Minesweeper"
                        target="_blank"
                        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium
                        bg-indigo-500/80 hover:bg-indigo-500
                        text-white rounded-md
                        shadow-sm hover:shadow-md
                        transition-all duration-200"
                    >
                        <GitHubIcon />
                        <span>View Repository</span>
                    </a>
                </div>
            </article>

            <!-- ================= Project 3 ================= -->
            <article
                class="project-card card-glow reveal p-7 h-full flex flex-col rounded-xl border border-zinc-700 bg-zinc-800/70 backdrop-blur-sm transition"
            >
                <div class="flex items-start justify-between">
                    <h3 class="text-base font-semibold text-zinc-100">
                        Infinite Tic Tac Toe
                    </h3>
                    <span class="badge badge-completed">Completed</span>
                </div>

                <p class="text-zinc-400 mt-3 leading-relaxed">
                    An extended Tic Tac Toe system with a dynamically expanding
                    board supporting scalable state tracking and rule
                    enforcement.
                </p>

                <div class="mt-auto pt-6 flex flex-col gap-4">
                    <div class="flex flex-wrap gap-2">
                        <span class="tag">Python</span>
                        <span class="tag">Tkinter</span>
                    </div>

                    <a
                        href="https://github.com/srj011/Infinite-Tic-Tac-Toe"
                        target="_blank"
                        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium
                        bg-indigo-500/80 hover:bg-indigo-500
                        text-white rounded-md
                        shadow-sm hover:shadow-md
                        transition-all duration-200"
                    >
                        <GitHubIcon />
                        <span>View Repository</span>
                    </a>
                </div>
            </article>

            <!-- ================= Project 4 ================= -->
            <article
                class="project-card card-glow reveal p-7 h-full flex flex-col rounded-xl border border-zinc-700 bg-zinc-800/70 backdrop-blur-sm transition"
            >
                <div class="flex items-start justify-between">
                    <h3 class="text-base font-semibold text-zinc-100">
                        Rock Paper Scissors
                    </h3>
                    <span class="badge badge-ongoing">Ongoing</span>
                </div>

                <p class="text-zinc-400 mt-3 leading-relaxed">
                    A modular Rust implementation using enums and pattern
                    matching, focused on safe state management and clean
                    architecture.
                </p>

                <div class="mt-auto pt-6 flex flex-col gap-4">
                    <div class="flex flex-wrap gap-2">
                        <span class="tag">Rust</span>
                        <span class="tag">egui</span>
                        <span class="tag">eframe</span>
                    </div>

                    <a
                        href="https://github.com/srj011/Rock-Paper-Scissors-egui"
                        target="_blank"
                        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium
                        bg-indigo-500/80 hover:bg-indigo-500
                        text-white rounded-md
                        shadow-sm hover:shadow-md
                        transition-all duration-200"
                    >
                        <GitHubIcon />
                        <span>View Repository</span>
                    </a>
                </div>
            </article>
        </div>
    </div>
</section>
