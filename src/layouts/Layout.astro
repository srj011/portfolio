---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import SmoothScroll from "../components/SmoothScroll.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <!-- Basic -->
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#0b0f1a" />

        <!-- SEO -->
        <title>Samved Raj – Systems & Web Developer</title>
        <meta
            name="description"
            content="Samved Raj – Systems & Web Application Developer specializing in Rust, Web Development, and Systems Engineering."
        />
        <link rel="canonical" href="https://srj011.is-a.dev/" />

        <!-- Open Graph -->
        <meta
            property="og:title"
            content="Samved Raj – Systems & Web Developer"
        />
        <meta
            property="og:description"
            content="Rust, Web Development, and Systems Engineering projects."
        />
        <meta
            property="og:image"
            content="https://srj011.is-a.dev/og-image.png"
        />
        <meta property="og:url" content="https://srj011.is-a.dev/" />
        <meta property="og:type" content="website" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta
            name="twitter:title"
            content="Samved Raj – Systems & Web Developer"
        />
        <meta
            name="twitter:description"
            content="Rust, Web Development, and Systems Engineering projects."
        />
        <meta
            name="twitter:image"
            content="https://srj011.is-a.dev/og-image.png"
        />

        <!-- Favicon -->
        <link rel="icon" href="/SR_logo.ico" sizes="any" />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;600;800&family=JetBrains+Mono&display=swap"
            rel="stylesheet"
        />

        <!-- Devicon Icons -->
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
        />
    </head>

    <body
        class="relative bg-zinc-950 text-zinc-100
             font-[Lexend] overflow-x-hidden"
    >
        <Navbar />

        <main class="pt-16 relative z-10">
            <slot />
        </main>

        <Footer />

        <!-- Back to top button -->
        <button
            id="back-to-top"
            class="fixed bottom-6 right-6 p-3 rounded-full bg-zinc-800/80 backdrop-blur-md border border-zinc-700 text-zinc-400 hover:text-white hover:border-indigo-500/50 hover:bg-zinc-700 transition-all duration-300 opacity-0 invisible z-40"
            aria-label="Back to top"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="m18 15-6-6-6 6"></path>
            </svg>
        </button>

        <Analytics />

        <!-- ALL DOM LOGIC GOES HERE -->
        <script is:inline>
            /* ================= Scroll Reveal ================= */
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("visible");
                        } else {
                            entry.target.classList.remove("visible");
                        }
                    });
                },
                {
                    threshold: 0.15,
                },
            );

            document
                .querySelectorAll(".reveal")
                .forEach((el) => observer.observe(el));

            /* ================= Navbar Logic ================= */
            const navbar = document.getElementById("navbar");
            const progress = document.getElementById("scroll-progress");
            const menuBtn = document.getElementById("menu-btn");
            const mobileMenu = document.getElementById("mobile-menu");
            const links = document.querySelectorAll("[data-link]");

            window.addEventListener("scroll", () => {
                const scrollY = window.scrollY;

                /* Shrink navbar */
                navbar?.classList.toggle("h-14", scrollY > 20);
                navbar?.classList.toggle("h-16", scrollY <= 20);

                /* Scroll progress */
                const height =
                    document.documentElement.scrollHeight -
                    document.documentElement.clientHeight;
                if (progress) {
                    progress.style.width = `${(scrollY / height) * 100}%`;
                }

                /* Active link */
                let activeLink = null;
                let maxVisibility = 0;

                links.forEach((link) => {
                    const href = link.getAttribute("href");
                    if (!href) return;

                    const section = document.querySelector(href);
                    if (!section) return;

                    const rect = section.getBoundingClientRect();
                    const viewportHeight = window.innerHeight;

                    // Calculate how much of the section is visible in viewport
                    const visibleTop = Math.max(0, rect.top);
                    const visibleBottom = Math.min(viewportHeight, rect.bottom);
                    const visibleHeight = Math.max(
                        0,
                        visibleBottom - visibleTop,
                    );
                    const visibility = visibleHeight / rect.height;

                    // Also consider proximity to top of viewport (target is ~120px from top)
                    const distanceFromTarget = Math.abs(rect.top - 120);

                    if (
                        visibility > maxVisibility ||
                        (visibility === maxVisibility &&
                            distanceFromTarget < 50)
                    ) {
                        maxVisibility = visibility;
                        activeLink = link;
                    }
                });

                links.forEach((l) => l.classList.remove("active"));
                if (activeLink && maxVisibility > 0.1) {
                    activeLink.classList.add("active");
                }

                /* Remove active class when in hero (top of page) */
                if (window.scrollY < 100) {
                    links.forEach((l) => l.classList.remove("active"));
                }
            });

            /* Mobile menu */
            menuBtn?.addEventListener("click", () => {
                mobileMenu?.classList.toggle("hidden");
            });

            document.querySelectorAll(".mobile-link").forEach((link) => {
                link.addEventListener("click", () => {
                    mobileMenu?.classList.add("hidden");
                });
            });

            /* ================= Back to Top ================= */
            const backToTop = document.getElementById("back-to-top");

            window.addEventListener("scroll", () => {
                if (window.scrollY > 500) {
                    backToTop?.classList.remove("opacity-0", "invisible");
                    backToTop?.classList.add("opacity-100", "visible");
                } else {
                    backToTop?.classList.remove("opacity-100", "visible");
                    backToTop?.classList.add("opacity-0", "invisible");
                }
            });

            backToTop?.addEventListener("click", () => {
                window.scrollTo({ top: 0, behavior: "smooth" });
            });
        </script>
        <SmoothScroll />
    </body>
</html>
